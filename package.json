{
  "name": "dsh-rabi-default-persona",
  "description": "Durable global Rabi persona prompt and its DSH settings page",
  "version": "0.1.4",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-rabi-default-persona.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-rabi-default-persona#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-rabi-default-persona/issues"
  },
  "scripts": {
    "test": "node --test tests/rabi-default-persona.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
